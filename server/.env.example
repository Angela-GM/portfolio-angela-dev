# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_...
# Email donde llegan los mensajes. Sin dominio verificado en Resend,
# tiene que ser el email de la cuenta de Resend.
CONTACT_TO=tu@email.com
# Opcional: remitente. Por defecto "Portfolio <onboarding@resend.dev>".
# RESEND_FROM=Portfolio <hola@tudominio.com>
# Opcional: orígenes permitidos para CORS, separados por comas.
# ALLOWED_ORIGINS=https://portfolio-angela-dev.vercel.app
